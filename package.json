{
  "name": "jsplaywriht",
  "version": "1.0.0",
  "description": "TypeScript end-to-end test framework using Playwright and Cucumber",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:web": "playwright test --grep @Web",
    "test:api": "playwright test --grep @API",
    "test:cucumber": "cucumber-js",
    "test:all": "npm run typecheck && npm test && npm run test:cucumber"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreiRymskikh/jsPlaywriht.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AndreiRymskikh/jsPlaywriht/issues"
  },
  "homepage": "https://github.com/AndreiRymskikh/jsPlaywriht#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.1",
    "@playwright/test": "^1.39.0",
    "@types/node": "^20.10.0",
    "allure-playwright": "^2.9.2",
    "dotenv": "^16.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
